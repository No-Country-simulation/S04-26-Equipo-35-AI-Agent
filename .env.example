# =============================================================================
# ConversaAI — Variables de entorno (copiar a .env.local en la raíz)
# =============================================================================
# Next.js lee .env.local automáticamente.
# El pipeline Python (carpeta Agentes/) lee Agentes/.env — puedes duplicar
# las claves de Supabase/LLM allí o usar un symlink.
# =============================================================================

# ── Supabase (dashboard + copiloto + pipeline) ───────────────────────────────
# Dashboard: usar prefijo NEXT_PUBLIC_ para lectura en cliente (solo anon key en prod)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=tu_service_role_o_anon_key

# Mismo valor sin prefijo si algún script del monorepo lo requiere
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_service_role_key

# ── Copiloto (Next.js /api/chat) ─────────────────────────────────────────────
GROQ_API_KEY=tu_groq_api_key

# Opcional: Gemini desde el front si migras el copiloto
# GEMINI_API_KEY=

# ── RAG agéntico (búsqueda en conversaciones) ─────────────────────────────────
# Qdrant: docker compose up -d en la raíz del repo
QDRANT_URL=http://127.0.0.1:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=conversaai_messages

# Cohere: embeddings de query para Qdrant (mismo modelo que el pipeline Python)
COHERE_API_KEY=tu_cohere_api_key

# ── Pipeline Python (Agentes/.env) ───────────────────────────────────────────
# LLM_SMART_PROVIDER=groq|gemini|anthropic
# LLM_SMART=llama-3.3-70b-versatile
# LLM_SMART_PROVIDER=gemini
# LLM_SMART=gemini-2.5-flash
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CORPUS_PATH=data/raw/data_conversa_ai.csv
