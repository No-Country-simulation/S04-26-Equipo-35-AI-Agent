# ── LLM (Groq / Anthropic) ───────────────────────────────────────────────────
GROQ_API_KEY=tu_api_key_aqui
LLM_FAST=llama-3.3-70b-versatile
LLM_SMART=qwen-qwq-32b

# ── Paths ────────────────────────────────────────────────────────────────────
CORPUS_PATH=data/raw/corpus_mes.csv
OUTPUT_PATH=data/processed/
REPORTS_PATH=reports/

# ── Supabase (PostgreSQL en la nube) ─────────────────────────────────────────
# Obtener en: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_service_role_key_aqui

# ── Cohere (Embeddings API) ──────────────────────────────────────────────────
# Obtener gratis en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=tu_cohere_api_key_aqui

# ── Qdrant (Base de datos vectorial — Docker local) ──────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
